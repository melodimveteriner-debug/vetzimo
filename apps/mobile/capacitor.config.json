{
  "appId": "com.vetzimo.app",
  "appName": "VetZimo",
  "webDir": "www",
  "server": {
    "url": "https://vetzimo.com/app",
    "cleartext": false,
    "allowNavigation": [
      "vetzimo.com",
      "*.vetzimo.com"
    ],
    "errorPath": "offline.html",
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false,
    "appendUserAgent": "VetZimoApp/1.0 (Android)"
  },
  "ios": {
    "contentInset": "never",
    "limitsNavigationsToAppBoundDomains": true,
    "appendUserAgent": "VetZimoApp/1.0 (iOS)",
    "scheme": "VetZimo"
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    },
    "SplashScreen": {
      "launchShowDuration": 900,
      "launchAutoHide": true,
      "backgroundColor": "#6a3df0",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#6a3df0",
      "overlaysWebView": false
    }
  }
}
