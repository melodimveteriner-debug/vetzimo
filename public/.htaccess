Options -Indexes
# Sunucu düzeyindeki hatalarda ham hata yerine "Oops!" sayfası
ErrorDocument 403 /oops.html
ErrorDocument 500 /oops.html
ErrorDocument 502 /oops.html
ErrorDocument 503 /oops.html
DirectoryIndex index.php
RewriteEngine On
# Sürüm etiketli (?v=...) statik dosyalar değişmez: tarayıcı bir yıl saklar, her açılışta yeniden sormaz (yavaş hatlarda büyük kazanç).
RewriteCond %{QUERY_STRING} (?:^|&)v=
RewriteRule \.(?:js|mjs|css|json|webp|png|jpe?g|svg|gif|ico|woff2?|ttf|wasm)$ - [E=VZ_IMMUTABLE:1]
RewriteRule "(^|/)(?:\.git|\.svn|\.env(?:\.[^/]*)?)(/|$)" - [F,END,NC]
<FilesMatch "(?i)(?:\.(?:bak|sql|orig|swp)|~)$">
    Require all denied
</FilesMatch>
RewriteRule ^uygulama-indir/?$ /platform/uygulama-indir [R=302,END]
RewriteRule ^(?:uygulama|\.well-known/assetlinks\.json|\.well-known/apple-app-site-association)$ index.php [END]
RewriteRule ^(?:market-pages(?:/|$)|vendor/vebot(?:/|$)) - [R=404,END,NC]
RewriteRule ^(?:(?:app|giris|hasta-sahibi|yonetim|clinic|klinik)/?$|platform(?:/|$)|api/|download(?:/|$)|indir(?:/|$)) index.php [END]

RewriteRule ^(?:web-sitem(?:/|$)|(?:web|siteler)(?:/|$)|yonetim/web-siteleri$) index.php [END]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [END]

<FilesMatch "(?i)^(?:config\.php|initial-workspace\.json|identity(?:-merkez-[a-z0-9-]+)?\.html|index\.html|legacy-portal\.html)$">
    Require all denied
</FilesMatch>

<IfModule mod_mime.c>
    AddType application/wasm .wasm
    AddType application/manifest+json .webmanifest
    AddType text/javascript .mjs
</IfModule>

# Güvenlik başlıkları (tüm yanıtlar: sayfalar, API ve statik dosyalar)
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Permissions-Policy "camera=(self), microphone=(self), geolocation=(self), payment=(), usb=(), serial=(), bluetooth=(), interest-cohort=()"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always setifempty Referrer-Policy "strict-origin-when-cross-origin"
    Header always unset X-Powered-By
</IfModule>

# Kurulum sihirbazı yalnızca ilk kurulumda çalışır: config.php'de installationToken boşsa (403) veya veritabanı
# doluysa (409) kendini kilitler. Kurulumdan sonra public/install.php dosyasını silin.

# Sunucu ayar ve hata kayıt dosyaları (cPanel bunları public/ içine yazar) dışarıya kapalı.
<FilesMatch "(?i)^(?:error_log|php\.ini|\.user\.ini|php_errorlog)$">
    Require all denied
</FilesMatch>

# Önbellek: sürümlü dosyalar 1 yıl (değişince adresi değişir); sürümsüz kod/stil her açılışta kısa doğrulama (304),
# sürümsüz görsel ve yazı tipleri 7 gün. Sayfalar ve API (PHP) kendi no-store başlığını gönderir.
<IfModule mod_headers.c>
    <FilesMatch "(?i)\.(?:js|mjs|css|json|wasm)$">
        Header set Cache-Control "no-cache" env=!VZ_IMMUTABLE
        Header set Cache-Control "public, max-age=31536000, immutable" env=VZ_IMMUTABLE
    </FilesMatch>
    <FilesMatch "(?i)\.(?:webp|png|jpe?g|svg|gif|ico|woff2?|ttf)$">
        Header set Cache-Control "public, max-age=604800" env=!VZ_IMMUTABLE
        Header set Cache-Control "public, max-age=31536000, immutable" env=VZ_IMMUTABLE
    </FilesMatch>
</IfModule>

